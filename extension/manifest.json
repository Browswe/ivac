{
  "manifest_version": 3,
  "name": "IVAC Assistant",
  "version": "4.0.0",
  "description": "IVAC profile manager, form filler and appointment slot watcher.",
  "permissions": ["storage", "notifications", "alarms"],
  "host_permissions": [
    "https://www.ivacbd.com/*",
    "https://ivacbd.com/*",
    "https://www.indianvisa-bangladesh.nic.in/*",
    "https://indianvisa-bangladesh.nic.in/*",
    "https://appointment.ivacbd.com/*"
  ],
  "action": {"default_popup":"popup.html","default_title":"IVAC Assistant"},
  "background": {"service_worker":"background.js"},
  "content_scripts": [{
    "matches": [
      "https://www.ivacbd.com/*",
      "https://ivacbd.com/*",
      "https://www.indianvisa-bangladesh.nic.in/*",
      "https://indianvisa-bangladesh.nic.in/*",
      "https://appointment.ivacbd.com/*"
    ],
    "js":["content.js"],
    "run_at":"document_idle"
  }]
}